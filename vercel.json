{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/radar",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/send-emails",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/send-emails",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/sniper.py": {
      "maxDuration": 60
    },
    "app/api/cron/send-emails/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/radar/route.ts": {
      "maxDuration": 300
    }
  }
}
