// Nastavení Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// DEFINICE ENUMŮ
enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  MEETING_SET
  CLOSED_WON
  CLOSED_LOST
  /** Breakup — poslední mail / ukončení outreach. */
  BREAK_UP
}

enum LeadSource {
  RADAR
  SNIPER
  MANUAL
  AUTOPILOT
  /** Firmý nalezené a zpracované Full Auto (ne Sběr / Odesílání). */
  FULL_AUTO
}

/** Jak byl lead osloven e-mailem (CRM zobrazí místo zdroje nalezení). */
enum ContactedVia {
  SNIPER
  AUTOPILOT_SNIPER
}

enum EmailQueueStatus {
  PENDING
  SENT
  FAILED
}

enum OutreachKind {
  INITIAL
  FOLLOW_UP
  BREAKUP
}

enum EmailConnectionProvider {
  GOOGLE
  OUTLOOK_SMTP
  CUSTOM_SMTP
}

enum EmailConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// TABULKA: UŽIVATEL
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  role          UserRole  @default(MEMBER)
  
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  onboardingTourCompleted Boolean @default(false)

  /** Bezpečná změna e-mailu: čekající nová adresa + 6místný ověřovací kód s expirací. */
  pendingEmail                   String?
  emailVerificationCode          String?
  emailVerificationCodeExpiresAt DateTime?

  /** Obnova zapomenutého hesla: unikátní token s expirací. */
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  emailConnection UserEmailConnection?
  documents       WorkspaceDocument[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// TABULKA: PRACOVNÍ PROSTOR
model Workspace {
  id            String    @id @default(cuid())
  name          String

  companyName    String?
  industry       String?
  targetAudience String?
  defaultTone    String?
  offeredServices String[] @default([])

  subscriptionStatus String   @default("FREE")
  trialEndsAt        DateTime?
  subscriptionPeriodEnd DateTime?
  stripeCustomerId   String?
  stripeSubscriptionId String?
  planTier           String   @default("NONE")

  creditsUsed      Int @default(0)
  creditsTotal     Int @default(10)
  leadsCount       Int @default(0)
  emailsSent       Int @default(0)
  activeDeals      Int @default(0)
  pipelineValue    Int @default(0)
  
  emailSignature String?  @db.Text
  systemPrompt   String?  @db.Text
  /** Zakázaná slova a fráze pro AI generování (čárkou oddělená). */
  forbiddenWords String?  @db.Text
  /** Profil firmy pro AI generování e-mailů (Sniper). */
  companyContext String?  @db.Text
  /** Detailní popis nabízených služeb pro AI generování e-mailů. */
  companyServices String? @db.Text
  webhookUrl     String?
  crmApiKey      String?
  
  members       User[]
  leads         Lead[]
  templates     Template[]
  services      Service[]
  activityLogs  ActivityLog[]
  radarSettings RadarSettings?
  emailConnection WorkspaceEmailConnection?
  googleSheetsConnection WorkspaceGoogleSheetsConnection?
  microsoftConnection WorkspaceMicrosoftConnection?
  fakturoidConnection WorkspaceFakturoidConnection?
  documents     WorkspaceDocument[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RadarSettings {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /** Cílové obory — jeden záznam = jeden obor. */
  targetIndustries  String[]  @default([])
  /** Lokality — každý řádek v UI = jedna lokalita (ukládáno jako newline text). */
  locations         String    @default("") @db.Text
  /** ISO country for Places regionCode (e.g. CZ, DE, GB). Empty = no bias. */
  countryCode       String    @default("CZ")
  /** any | micro | small | medium | large */
  companySize       String    @default("any")
  autoStartOutreach Boolean   @default(false)

  scheduleDays      Int[]     @default([1, 4])
  scheduleTime      String    @default("03:00")
  resultsPerQuery   Int       @default(20)
  /** Soft dolní cíl firem na běh (snaží se dostat aspoň sem). */
  minCompaniesPerRun Int      @default(20)
  maxCompaniesPerRun Int      @default(50)
  /** Poslední úspěšný běh naplánovaného Radaru (cron). */
  lastScheduledRunAt DateTime?

  /** Automatický noční/denní sběr Radaru (cron /api/cron/radar). */
  radarCronEnabled   Boolean  @default(true)
  /** Automatické odesílání fronty (cron /api/cron/send-emails). */
  emailSendCronEnabled Boolean @default(false)

  /** Full Auto — kompletní smyčka Radar → fronta → odeslání. */
  fullAutoEnabled    Boolean  @default(false)
  /** once_weekly | twice_weekly | daily */
  fullAutoFrequency  String   @default("twice_weekly")
  fullAutoRunTime    String   @default("08:00")
  lastFullAutoRunAt  DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ActivityLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionType  String
  title       String
  description String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
}

// TABULKA: SLUŽBY (nabídka pro Sniper / outreach)
model Service {
  id          String    @id @default(cuid())
  name        String
  description String    @db.Text

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// TABULKA: LEAD
model Lead {
  id            String     @id @default(cuid())
  companyName   String
  domain        String?
  /** Cached favicon URL for CRM avatar (usually Google s2 for the domain). */
  faviconUrl    String?
  placeId       String?
  value         Int?       @default(0)
  email         String?
  phone         String?
  contactEmail  String?
  contactPhone  String?
  industry      String?
  /**
   * Neviditelné tagy pro filtraci (fitka, gastro, …) — odvozené z názvu / query / Places.
   * V UI se na kartách neukazují, jen ve filtrech.
   */
  tags          String[]   @default([])
  /** ISO country from Radar search (e.g. CZ, DE, GB) — drives email language hints. */
  countryCode   String?
  /** Kdo lead zapsal (např. Jan Sedlář / Matěj Pazdera / Filip Retzl). */
  author        String?
  status        LeadStatus @default(NEW)
  /** Odkud lead přišel — řídí list v Google Sheets (Radar / Sniper). */
  source        LeadSource @default(MANUAL)
  /** Po odeslání e-mailu: Sniper vs Autopilot-Sniper (CRM štítek). */
  contactedVia  ContactedVia?

  /** Kdy někdo z týmu otevřel web firmy (zeměkoule v CRM). */
  websiteVisitedAt DateTime?
  /** Kdo web otevřel (např. Jan Sedlář). */
  websiteVisitedBy String?

  /** Poslední odeslaný outreach e-mail. */
  lastContactedAt   DateTime?
  /** Kdy je další follow-up / breakup splatný. */
  nextOutreachAt    DateTime?
  nextOutreachKind  OutreachKind?
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id])
  
  emailQueue    EmailQueue[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([workspaceId, placeId])
  @@index([workspaceId, domain])
  @@index([workspaceId, source])
  @@index([workspaceId, nextOutreachAt])
}

model EmailQueue {
  id           String           @id @default(cuid())
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject      String
  htmlBody     String           @db.Text
  scheduledAt  DateTime
  status       EmailQueueStatus @default(PENDING)
  kind         OutreachKind     @default(INITIAL)
  /** Kdo mail zařadil — odesílá se z jeho osobního e-mailu (fallback workspace). */
  senderUserId String?
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime         @default(now())

  @@index([status, scheduledAt])
  @@index([leadId, status])
  @@index([senderUserId])
}

model WorkspaceEmailConnection {
  id          String                  @id @default(cuid())
  workspaceId String                  @unique
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider    EmailConnectionProvider?
  status      EmailConnectionStatus     @default(DISCONNECTED)

  senderName  String?
  senderEmail String?
  smtpHost    String?
  smtpPort    Int?
  /** AES-256-GCM encrypted app password / SMTP secret */
  smtpSecret  String?                   @db.Text

  googleAccessToken      String?       @db.Text
  googleRefreshToken     String?       @db.Text
  googleTokenExpiresAt   DateTime?

  connectedAt DateTime?
  lastError   String?

  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

/** Osobní odesílací schránka člena týmu (každý má svůj venegard e-mail). */
model UserEmailConnection {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider    EmailConnectionProvider?
  status      EmailConnectionStatus     @default(DISCONNECTED)

  senderName  String?
  senderEmail String?
  smtpHost    String?
  smtpPort    Int?
  smtpSecret  String?                   @db.Text

  googleAccessToken      String?       @db.Text
  googleRefreshToken     String?       @db.Text
  googleTokenExpiresAt   DateTime?

  connectedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Live mirror of CRM leads into a Google Spreadsheet (App → Sheets). */
model WorkspaceGoogleSheetsConnection {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status EmailConnectionStatus @default(DISCONNECTED)

  googleAccessToken      String?   @db.Text
  googleRefreshToken     String?   @db.Text
  googleTokenExpiresAt   DateTime?
  googleAccountEmail     String?

  spreadsheetId    String?
  spreadsheetUrl   String?
  spreadsheetTitle String?
  sheetName        String  @default("CRM")
  /** Pokud true, sync píše do listů Radar + Sniper (historická outreach DB). */
  splitBySource    Boolean @default(false)
  /**
   * Historická outreach tabulka (Master / Radar / Sniper) — Radar podle ní vylučuje
   * firmy, i když už nejsou v app CRM. Sync live CRM sheetu ji nepřepisuje.
   */
  archiveSpreadsheetId  String?
  archiveSpreadsheetUrl String?
  syncEnabled      Boolean @default(true)
  lastSyncedAt     DateTime?
  lastError        String?
  connectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TABULKA: ŠABLONY
model Template {
  id            String    @id @default(cuid())
  name          String
  subject       String
  body          String    @db.Text
  
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
}

/** Jednoduchý rate-limit bucket (sliding window přes DB, bez Redis). */
model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String
  windowStart DateTime
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([key])
}

/** Microsoft 365 — OneDrive / Excel / Word (Graph API). */
model WorkspaceMicrosoftConnection {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status EmailConnectionStatus @default(DISCONNECTED)

  msAccessToken      String?   @db.Text
  msRefreshToken     String?   @db.Text
  msTokenExpiresAt   DateTime?
  msAccountEmail     String?
  msDisplayName      String?

  lastError   String?
  connectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** Fakturoid — faktury z Generátoru (OAuth Client Credentials z účtu uživatele). */
model WorkspaceFakturoidConnection {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status EmailConnectionStatus @default(DISCONNECTED)

  /** Client ID z Fakturoid → Nastavení → Uživatelský účet */
  clientId           String?
  /** AES-GCM šifrovaný Client Secret */
  clientSecretEnc    String?   @db.Text
  accessToken        String?   @db.Text
  tokenExpiresAt     DateTime?
  /** Account slug v URL Fakturoidu (např. moje-firma) */
  accountSlug        String?
  accountName        String?
  accountEmail       String?

  lastError   String?
  connectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DocumentScope {
  PERSONAL
  SHARED
}

enum DocumentKind {
  UPLOAD
  OFFER
  CONTRACT
  INVOICE
}

/** Soubory v Úložišti — osobní (jen owner) nebo společné (celý workspace). */
model WorkspaceDocument {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  ownerUserId String
  owner       User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  scope       DocumentScope
  kind        DocumentKind @default(UPLOAD)

  name        String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String

  /** Metadata nabídky/smlouvy (JSON). */
  metaJson    String?      @db.Text

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId, scope])
  @@index([workspaceId, ownerUserId, scope])
}