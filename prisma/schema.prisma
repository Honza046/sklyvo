// Nastavení Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// DEFINICE ENUMŮ
enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  MEETING_SET
  CLOSED_WON
  CLOSED_LOST
}

enum EmailQueueStatus {
  PENDING
  SENT
  FAILED
}

enum EmailConnectionProvider {
  GOOGLE
  OUTLOOK_SMTP
  CUSTOM_SMTP
}

enum EmailConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// TABULKA: UŽIVATEL
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  avatarUrl     String?
  role          UserRole  @default(MEMBER)
  
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  onboardingTourCompleted Boolean @default(false)

  /** Bezpečná změna e-mailu: čekající nová adresa + 6místný ověřovací kód s expirací. */
  pendingEmail                   String?
  emailVerificationCode          String?
  emailVerificationCodeExpiresAt DateTime?

  /** Obnova zapomenutého hesla: unikátní token s expirací. */
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// TABULKA: PRACOVNÍ PROSTOR
model Workspace {
  id            String    @id @default(cuid())
  name          String

  companyName    String?
  industry       String?
  targetAudience String?
  defaultTone    String?
  offeredServices String[] @default([])

  subscriptionStatus String   @default("FREE")
  trialEndsAt        DateTime?
  subscriptionPeriodEnd DateTime?
  stripeCustomerId   String?
  stripeSubscriptionId String?
  planTier           String   @default("NONE")

  creditsUsed      Int @default(0)
  creditsTotal     Int @default(10)
  leadsCount       Int @default(0)
  emailsSent       Int @default(0)
  activeDeals      Int @default(0)
  pipelineValue    Int @default(0)
  
  emailSignature String?  @db.Text
  systemPrompt   String?  @db.Text
  /** Zakázaná slova a fráze pro AI generování (čárkou oddělená). */
  forbiddenWords String?  @db.Text
  /** Profil firmy pro AI generování e-mailů (Sniper). */
  companyContext String?  @db.Text
  /** Detailní popis nabízených služeb pro AI generování e-mailů. */
  companyServices String? @db.Text
  webhookUrl     String?
  crmApiKey      String?
  
  members       User[]
  leads         Lead[]
  templates     Template[]
  services      Service[]
  activityLogs  ActivityLog[]
  radarSettings RadarSettings?
  emailConnection WorkspaceEmailConnection?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RadarSettings {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /** Cílové obory — jeden záznam = jeden obor. */
  targetIndustries  String[]  @default([])
  /** Lokality — každý řádek v UI = jedna lokalita (ukládáno jako newline text). */
  locations         String    @default("") @db.Text
  /** any | micro | small | medium | large */
  companySize       String    @default("any")
  autoStartOutreach Boolean   @default(false)

  scheduleDays      Int[]     @default([1, 4])
  scheduleTime      String    @default("03:00")
  resultsPerQuery   Int       @default(8)
  maxCompaniesPerRun Int      @default(50)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ActivityLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionType  String
  title       String
  description String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
}

// TABULKA: SLUŽBY (nabídka pro Sniper / outreach)
model Service {
  id          String    @id @default(cuid())
  name        String
  description String    @db.Text

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// TABULKA: LEAD
model Lead {
  id            String     @id @default(cuid())
  companyName   String
  domain        String?
  placeId       String?
  value         Int?       @default(0)
  email         String?
  phone         String?
  contactEmail  String?
  contactPhone  String?
  industry      String?
  status        LeadStatus @default(NEW)
  
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id])
  
  emailQueue    EmailQueue[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([workspaceId, placeId])
  @@index([workspaceId, domain])
}

model EmailQueue {
  id           String           @id @default(cuid())
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subject      String
  htmlBody     String           @db.Text
  scheduledAt  DateTime
  status       EmailQueueStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime         @default(now())

  @@index([status, scheduledAt])
  @@index([leadId, status])
}

model WorkspaceEmailConnection {
  id          String                  @id @default(cuid())
  workspaceId String                  @unique
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  provider    EmailConnectionProvider?
  status      EmailConnectionStatus     @default(DISCONNECTED)

  senderName  String?
  senderEmail String?
  smtpHost    String?
  smtpPort    Int?
  /** AES-256-GCM encrypted app password / SMTP secret */
  smtpSecret  String?                   @db.Text

  googleAccessToken      String?       @db.Text
  googleRefreshToken     String?       @db.Text
  googleTokenExpiresAt   DateTime?

  connectedAt DateTime?
  lastError   String?

  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

// TABULKA: ŠABLONY
model Template {
  id            String    @id @default(cuid())
  name          String
  subject       String
  body          String    @db.Text
  
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
}