# Sklyvo Backend — environment template
# Copy to .env.local / Vercel env. Do not commit real secrets.

# --- Auth / DB (REQUIRED in production) ---
# DATABASE_URL=
SESSION_SECRET=change-me-to-at-least-32-random-characters
CRON_SECRET=change-me-cron-secret
EMAIL_CREDENTIALS_SECRET=change-me-email-credentials-secret

# --- Google ---
GOOGLE_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Microsoft 365 (OneDrive / Excel / Word) ---
# Azure Portal → App registrations → New registration (Accounts in any org + personal)
# Redirect URI (Web): {NEXT_PUBLIC_APP_URL}/api/integrations/microsoft/callback
# API permissions (delegated): User.Read, Files.ReadWrite, Files.Read.All, offline_access, openid, profile, email
# Certificates & secrets → New client secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional; default "common" (work + personal Microsoft accounts)
# MICROSOFT_TENANT_ID=common
# Optional override; default derives from NEXT_PUBLIC_APP_URL
# MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback

# --- Radar multi-source ---
SERPER_API_KEY=
HUNTER_API_KEY=
PROXYCURL_API_KEY=
RADAR_SERPER_MAX=10
RADAR_HUNTER_MAX=20
RADAR_PROXYCURL_MAX=10

# --- Gemini models (COGS) ---
SNIPER_GEMINI_MODEL=gemini-3.5-flash
AUTOPILOT_GEMINI_MODEL=gemini-2.0-flash-lite

# See docs/radar-cogs.md and docs/tenant-isolation.md

# --- Platform admin (Sklyvo Admin) ---
# Comma-separated allowlist for /admin. Production (Vercel): only Jan's email.
PLATFORM_ADMIN_EMAILS=jan@venegard.com

# Platform Fakturoid (Sklyvo branding PDF after Stripe payment).
# Separate from per-workspace Fakturoid in Integrace (customer accounts).
# PLATFORM_FAKTUROID_CLIENT_ID=
# PLATFORM_FAKTUROID_CLIENT_SECRET=
# PLATFORM_FAKTUROID_ACCOUNT_SLUG=
